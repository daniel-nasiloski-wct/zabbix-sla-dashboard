msgstr "%1$s práve prebieha"

msgid "None ongoing"
msgstr "Žiadne neprebiehajú"

msgid "Mean time to recover"
msgstr "Priemerný čas obnovy"

msgid "MTTR, resolved incidents"
msgstr "MTTR, vyriešené incidenty"

