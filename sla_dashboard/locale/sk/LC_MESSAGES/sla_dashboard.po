msgstr "Plnenie SLA"

msgid "%1$s services"
msgstr "Služby: %1$s"

msgid "SLI trend"
msgstr "Trend SLI"

msgid "Per SLA, time-weighted across its services; dashed line = SLO"
msgstr "Podľa SLA, vážené časom naprieč jeho službami; prerušovaná čiara = SLO"

msgid "SLI heatmap"
msgstr "Teplotná mapa SLI"

msgid "Each cell is one period of one service, compared with the SLO of its SLA"
msgstr "Každá bunka je jedna perióda jednej služby, porovnaná so SLO jej SLA"

msgid "No downtime in the selected period."
msgstr "Žiadny prestoj vo vybranej perióde."

msgid "Error budget used"
msgstr "Využitý rozpočet chýb"

msgid "Downtime as a share of what the SLO allows; marker = 100%"
msgstr "Prestoj ako podiel toho, čo SLO dovoľuje; značka = 100%"

msgid "Top downtime"
msgstr "Najväčší prestoj"

msgid "Services with the most downtime in the selected period"
msgstr "Služby s najväčším prestojom vo vybranej perióde"

#. Mean time to recover, abbreviation (table column)
msgid "MTTR"
msgstr "MTTR"

#. table column with a sparkline
msgid "Trend"
msgstr "Trend"

msgid "Click a service to open its SLA report"
msgstr "Kliknite na službu pre otvorenie jej reportu SLA"

msgid "No enabled SLA matches the filter. Choose other SLAs, services, hosts or tags in the filter above."
msgstr "Filtru nezodpovedá žiadne povolené SLA. Vyberte iné SLA, služby, hosty alebo tagy vo filtri vyššie."

msgid "No service matches the filter."
msgstr "Filtru nezodpovedá žiadna služba."

msgid "Too many periods for the selected range: showing the last %1$s. Group by a longer period or choose a shorter range."
msgstr "Príliš veľa periód pre vybraný rozsah: zobrazuje sa posledných %1$s. Zoskupte podľa dlhšej periódy alebo vyberte kratší rozsah."

msgid "SLA dashboard"
msgstr "Dashboard SLA"
