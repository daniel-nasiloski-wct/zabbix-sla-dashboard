# SLA dashboard (módulo do Zabbix 8.0): textos que o domínio "frontend" do core não tem.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: da\n"

#. days, short (2d)
msgid "%1$sd"
msgstr "%1$sd"

#. hours, short (5h)
msgid "%1$sh"
msgstr "%1$st"

#. minutes, short (30m)
msgid "%1$sm"
msgstr "%1$sm"

#. seconds, short (10s)
msgid "%1$ss"
msgstr "%1$ss"

msgid "No downtime"
msgstr "Ingen nedetid"

msgid "Downtime within SLO"
msgstr "Nedetid inden for SLO"

msgid "Below SLO"
msgstr "Under SLO"

msgid "Overall SLI"
msgstr "Samlet SLI"

msgid "Time-weighted across %1$s services"
msgstr "Tidsvægtet på tværs af %1$s tjenester"

msgid "Services meeting SLO"
msgstr "Tjenester der opfylder SLO"

msgid "%1$s below SLO"
msgstr "%1$s under SLO"

msgid "All within SLO"
msgstr "Alle inden for SLO"

msgid "Incidents"
msgstr "Hændelser"

msgid "%1$s ongoing now"
msgstr "%1$s igangværende nu"

msgid "None ongoing"
msgstr "Ingen igangværende"

msgid "Mean time to recover"
msgstr "Gennemsnitlig gendannelsestid"

msgid "MTTR, resolved incidents"
msgstr "MTTR, løste hændelser"

msgid "SLA compliance"
msgstr "SLA-overholdelse"

msgid "%1$s services"
msgstr "%1$s tjenester"

msgid "SLI trend"
msgstr "SLI-tendens"

msgid "Per SLA, time-weighted across its services; dashed line = SLO"
msgstr "Pr. SLA, tidsvægtet på tværs af dens tjenester; stiplet linje = SLO"

msgid "SLI heatmap"
msgstr "SLI-varmekort"

msgid "Each cell is one period of one service, compared with the SLO of its SLA"
msgstr "Hver celle er én periode for én tjeneste, sammenlignet med SLO for dens SLA"

msgid "No downtime in the selected period."
msgstr "Ingen nedetid i den valgte periode."

msgid "Error budget used"
msgstr "Brugt fejlbudget"

msgid "Downtime as a share of what the SLO allows; marker = 100%"
msgstr "Nedetid som andel af det, SLO tillader; markør = 100%"

msgid "Top downtime"
msgstr "Mest nedetid"

msgid "Services with the most downtime in the selected period"
msgstr "Tjenester med mest nedetid i den valgte periode"

#. Mean time to recover, abbreviation (table column)
msgid "MTTR"
msgstr "MTTR"

#. table column with a sparkline
msgid "Trend"
msgstr "Tendens"

msgid "Click a service to open its SLA report"
msgstr "Klik på en tjeneste for at åbne dens SLA rapport"

msgid "No enabled SLA matches the filter. Choose other SLAs, services, hosts or tags in the filter above."
msgstr "Ingen aktiveret SLA matcher filteret. Vælg andre SLA'er, tjenester, værter eller tags i filteret ovenfor."

msgid "No service matches the filter."
msgstr "Ingen tjeneste matcher filteret."

msgid "Too many periods for the selected range: showing the last %1$s. Group by a longer period or choose a shorter range."
msgstr "For mange perioder for det valgte interval: viser de sidste %1$s. Gruppér efter en længere periode eller vælg et kortere interval."

msgid "SLA dashboard"
msgstr "SLA-dashboard"
