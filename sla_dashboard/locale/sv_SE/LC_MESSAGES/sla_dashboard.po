msgstr "Mest stilleståndstid"

msgid "Services with the most downtime in the selected period"
msgstr "Tjänster med mest stilleståndstid under vald period"

#. Mean time to recover, abbreviation (table column)
msgid "MTTR"
msgstr "MTTR"

#. table column with a sparkline
msgid "Trend"
msgstr "Trend"

msgid "Click a service to open its SLA report"
msgstr "Klicka på en tjänst för att öppna dess SLA-rapport"

msgid "No enabled SLA matches the filter. Choose other SLAs, services, hosts or tags in the filter above."
msgstr "Ingen aktiverad SLA matchar filtret. Välj andra SLA:er, tjänster, värdar eller taggar i filtret ovan."

msgid "No service matches the filter."
msgstr "Ingen tjänst matchar filtret."

msgid "Too many periods for the selected range: showing the last %1$s. Group by a longer period or choose a shorter range."
msgstr "För många perioder för valt intervall: visar de senaste %1$s. Gruppera efter en längre period eller välj ett kortare intervall."

msgid "SLA dashboard"
msgstr "SLA-instrumentpanel"
